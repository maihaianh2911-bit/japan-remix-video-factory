{"duration": 16.5, "voice": {"speaker": "青山龍星", "style": "ノーマル"}, "lines": [{"text": "みんなに笑われた「ほら吹き」が、東京のど真ん中に、日本で最初の地下鉄をつくりました。", "start": 0.0, "end": 4.8, "exact": true, "chars": [[0.058, 0.175], [0.175, 0.234], [0.234, 0.336], [0.336, 0.416], [0.416, 0.568], [0.568, 0.657], [0.657, 0.731], [0.731, 0.81], [0.81, 0.81], [0.81, 0.915], [0.915, 1.012], [1.012, 1.168], [1.168, 1.234], [1.234, 1.234], [1.234, 1.454], [1.454, 1.454], [1.632, 1.781], [1.781, 1.95], [1.95, 2.018], [2.018, 2.103], [2.103, 2.27], [2.27, 2.327], [2.327, 2.495], [2.495, 2.669], [2.669, 2.669], [2.841, 3.0], [3.0, 3.13], [3.13, 3.216], [3.216, 3.374], [3.374, 3.481], [3.481, 3.576], [3.576, 3.731], [3.731, 3.839], [3.839, 4.014], [4.014, 4.08], [4.08, 4.219], [4.219, 4.294], [4.294, 4.353], [4.353, 4.445], [4.445, 4.54], [4.54, 4.701], [4.701, 4.701]]}, {"text": "けれど13年後、彼はその地下鉄から追い出されます。", "start": 4.9, "end": 8.068, "exact": true, "chars": [[0.059, 0.171], [0.171, 0.259], [0.259, 0.377], [0.377, 0.545], [0.545, 0.738], [0.738, 0.875], [0.875, 1.111], [1.111, 1.111], [1.326, 1.452], [1.452, 1.536], [1.536, 1.648], [1.648, 1.767], [1.767, 1.909], [1.909, 2.011], [2.011, 2.149], [2.149, 2.248], [2.248, 2.33], [2.33, 2.441], [2.441, 2.509], [2.509, 2.612], [2.612, 2.719], [2.719, 2.779], [2.779, 2.883], [2.883, 3.068], [3.068, 3.068]]}, {"text": "男の名前は、早川徳次といいます。", "start": 8.368, "end": 10.907, "exact": true, "chars": [[0.059, 0.232], [0.232, 0.324], [0.324, 0.508], [0.508, 0.684], [0.684, 0.906], [0.906, 0.906], [1.074, 1.285], [1.285, 1.483], [1.483, 1.663], [1.663, 1.864], [1.864, 1.984], [1.984, 2.051], [2.051, 2.123], [2.123, 2.247], [2.247, 2.437], [2.437, 2.437]]}, {"text": "1914年、ロンドンで地下鉄を見た早川は、東京にもつくろうと決めました。", "start": 11.207, "end": 16.145, "exact": true, "chars": [[0.058, 0.337], [0.337, 0.554], [0.554, 0.802], [0.802, 0.994], [0.994, 1.215], [1.215, 1.215], [1.427, 1.56], [1.56, 1.636], [1.636, 1.748], [1.748, 1.81], [1.81, 1.896], [1.896, 2.045], [2.045, 2.174], [2.174, 2.347], [2