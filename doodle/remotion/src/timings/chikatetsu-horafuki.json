4], [3.234, 3.328], [3.328, 3.522], [3.522, 3.65], [3.65, 3.738], [3.738, 3.914], [3.914, 3.995], [3.995, 4.177], [4.177, 4.235], [4.235, 4.398], [4.398, 4.482], [4.482, 4.573], [4.573, 4.667], [4.667, 4.828], [4.828, 4.828]]}, {"text": "早川は社長を退き、自分がつくった地下鉄を去ります。", "start": 47.164, "end": 50.62, "chars": [[0.058, 0.286], [0.286, 0.486], [0.486, 0.579], [0.579, 0.852], [0.852, 0.969], [0.969, 1.09], [1.09, 1.272], [1.272, 1.468], [1.468, 1.468], [1.674, 1.828], [1.828, 1.944], [1.944, 2.028], [2.028, 2.141], [2.141, 2.232], [2.232, 2.328], [2.328, 2.408], [2.408, 2.531], [2.531, 2.624], [2.624, 2.774], [2.774, 2.856], [2.856, 3.01], [3.01, 3.066], [3.066, 3.174], [3.174, 3.356], [3.356, 3.356]]}, {"text": "その2年後、61歳で亡くなりました。", "start": 50.92, "end": 53.491, "chars": [[0.058, 0.216], [0.216, 0.315], [0.315, 0.468], [0.468, 0.569], [0.569, 0.785], [0.785, 0.785], [0.988, 1.267], [1.267, 1.461], [1.461, 1.668], [1.668, 1.706], [1.706, 1.88], [1.88, 1.961], [1.961, 2.059], [2.059, 2.117], [2.117, 2.212], [2.212, 2.308], [2.308, 2.47], [2.47, 2.47]]}, {"text": "いま東京の地下鉄は、毎日、何百万人もの人を運んでいます。", "start": 53.791, "end": 57.983, "chars": [[0.058, 0.121], [0.121, 0.226], [0.226, 0.378], [0.378, 0.547], [0.547, 0.609], [0.609, 0.78], [0.78, 0.899], [0.899, 1.062], [1.062, 1.258], [1.258, 1.258], [1.473, 1.641], [1.641, 1.943], [1.943, 1.943], [2.205, 2.398], [2.398, 2.612], [2.612, 2.779], [2.779, 2.938], [2.938, 3.035], [3.035, 3.131], [3.131, 3.296], [3.296, 3.351], [3.351, 3.59], [3.59, 3.653], [3.653, 3.739], [3.739, 3.792], [3.792, 3.907], [3.907, 4.092], [4.092, 4.092]]}, {"text": "2027年には、あの最初の線路が100歳になります。", "start": 58.283, "end": 61.685, "chars": [[0.058, 0.305], [0.305, 0.474], [0.474, 0.646], [0.646, 0.852], [0.852, 0.98], [0.98, 1.064], [1.064, 1.287], [1.287, 1.287], [1.472, 1.552], [1.552, 1.645], [1.645, 1.787], [1.787, 1.854], [1.854, 1.95], [1.95, 2.069], [2.069, 2.193], [2.193, 2.262], [2.262, 2.393], [2.393, 2.556], [2.556, 2.717], [2.717, 2.779], [2.779, 2.85